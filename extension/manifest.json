{
  "manifest_version": 3,
  "name": "PC Bridge — AI chat builds on your PC",
  "version": "1.1.0",
  "description": "Bridges DeepSeek, ChatGPT, Claude or Gemini chats to a local server that can run commands and write project files on your PC.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PC Bridge — open panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*"
      ],
      "js": ["shared.js", "adapters.js", "ui.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
